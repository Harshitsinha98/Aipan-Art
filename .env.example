# Postgres (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://user:password@localhost:5432/aipan?schema=public"

# Long random string — `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used for CSRF origin checks and emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay — dashboard.razorpay.com → Account & Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"
# Webhooks → add https://your-domain/api/checkout/webhook with events payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxx"

# Cloudinary for product photos (unsigned upload preset) — REQUIRED on Vercel.
# Without these, admin uploads are saved to ./uploads and served at /media/*
# (fine on a VPS/Railway with a volume, but NOT on Vercel — files don't persist there).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Google sign-in (optional). console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID (type: Web application).
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# First owner account created by `npm run db:seed`
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-this-password"
